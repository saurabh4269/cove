2c:["$","$L2a","prod-3",{"product":{"id":"prod-3","name":"Organic Cotton T-Shirt","slug":"organic-cotton-tshirt","description":"Heavyweight 100% organic cotton tee with a relaxed fit. Pre-shrunk and garment-dyed for a lived-in feel from day one.","images":[{"url":"/images/products/placeholder.svg","alt":"Cotton t-shirt front","width":800,"height":800}],"status":"active","categoryIds":["cat-2"],"tags":["organic","cotton","basics"],"variants":[{"id":"var-3-1","productId":"prod-3","sku":"TS-WHT-S","name":"White / S","price":2999,"currency":"USD","inventory":{"quantity":100,"trackInventory":true,"allowBackorder":false},"options":[{"name":"Color","value":"White"},{"name":"Size","value":"S"}],"images":[]},{"id":"var-3-2","productId":"prod-3","sku":"TS-WHT-M","name":"White / M","price":2999,"currency":"USD","inventory":{"quantity":80,"trackInventory":true,"allowBackorder":false},"options":[{"name":"Color","value":"White"},{"name":"Size","value":"M"}],"images":[]},{"id":"var-3-3","productId":"prod-3","sku":"TS-WHT-L","name":"White / L","price":2999,"currency":"USD","inventory":{"quantity":60,"trackInventory":true,"allowBackorder":false},"options":[{"name":"Color","value":"White"},{"name":"Size","value":"L"}],"images":[]},{"id":"var-3-4","productId":"prod-3","sku":"TS-BLK-M","name":"Black / M","price":2999,"currency":"USD","inventory":{"quantity":70,"trackInventory":true,"allowBackorder":false},"options":[{"name":"Color","value":"Black"},{"name":"Size","value":"M"}],"images":[]}],"featured":true,"createdAt":"2025-02-01T10:00:00Z","updatedAt":"2025-02-01T10:00:00Z","rating":4.3,"reviewCount":256,"brandId":"brand-3","body":"<h2>The Perfect Everyday Tee</h2><p>We spent two years sourcing the right organic cotton and perfecting the fit. The result is a t-shirt that feels like a favorite from day one.</p><h3>Details</h3><ul><li>100% GOTS-certified organic cotton</li><li>Heavyweight 6.5oz fabric</li><li>Garment-dyed for a lived-in feel</li><li>Pre-shrunk</li><li>Side seams for a clean drape</li></ul><h3>Care</h3><p>Machine wash cold, tumble dry low. The more you wash it, the better it gets.</p>"}}]
